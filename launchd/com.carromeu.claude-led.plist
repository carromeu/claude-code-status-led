<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent do daemon claude-led (macOS).

  O daemon é iniciado via shell de login (/bin/zsh -lc), que resolve o `node`
  do PATH do usuário em runtime — assim atualizações de versão do node
  (nvm/Homebrew) não quebram o serviço. Não há caminho de node fixo a manter.

  Instalação:
    1. Substitua __HOME__ pelo valor de $HOME (apenas nos caminhos de log).
    2. Copie para ~/Library/LaunchAgents/com.carromeu.claude-led.plist
    3. Carregue: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.carromeu.claude-led.plist

  Descarregar: launchctl bootout gui/$(id -u)/com.carromeu.claude-led
  Reiniciar:   launchctl kickstart -k gui/$(id -u)/com.carromeu.claude-led
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.carromeu.claude-led</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>exec node "$HOME/.claude-led/host/claude-led-daemon.js"</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude-led/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.claude-led/daemon.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
