{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude-led/hooks/claude-led-hook.js --event UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude-led/hooks/claude-led-hook.js --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude-led/hooks/claude-led-hook.js --event PreToolUseMcp"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude-led/hooks/claude-led-hook.js --event PreCompact"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude-led/hooks/claude-led-hook.js --event Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude-led/hooks/claude-led-hook.js --event Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude-led/hooks/claude-led-hook.js --event SessionEnd"
          }
        ]
      }
    ]
  }
}
